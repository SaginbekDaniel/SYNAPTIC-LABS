# NEXORA AI — environment variables. Copy to .env for local development.
# Contains NO real credentials. Never commit a filled-in .env (it is git-ignored).
# Every variable is optional locally; defaults live in src/nexora/settings.py.

# --- API + worker (prefix NEXORA_) -----------------------------------------------------------
# postgres://, postgresql:// and postgresql+psycopg:// are all accepted (rewritten to psycopg 3).
NEXORA_DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
NEXORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DEMO MODE identity recorded on every audit event. Not authentication.
NEXORA_DEMO_ANALYST=demo-analyst
# Serve /docs and /openapi.json. Set false wherever the API could be reached from the internet.
NEXORA_EXPOSE_API_DOCS=true
# Shared secret between gateway and API. Empty = check disabled (local dev only).
NEXORA_GATEWAY_TOKEN=
# Connection pool per process (api and worker each hold one).
NEXORA_DB_POOL_SIZE=5
NEXORA_DB_MAX_OVERFLOW=5
# Upload limits (the gateway caps request bodies at 21 MiB).
NEXORA_MAX_UPLOAD_BYTES=20971520
NEXORA_MAX_CSV_ROWS=200000
# Worker: lease length, retry budget, idle poll interval.
NEXORA_JOB_LEASE_SECONDS=120
NEXORA_JOB_MAX_ATTEMPTS=3
NEXORA_WORKER_POLL_SECONDS=1.0
# API container: bind address and port ("::" = IPv6 + IPv4, needed for Railway private networking).
# NEXORA_BIND_HOST=0.0.0.0
# PORT=8000

# --- Gateway (apps/web image, Nginx) -----------------------------------------------------------
# basic = HTTP Basic access control (default; the container refuses to start without credentials)
# off   = no access control (only for the loopback-bound docker compose stack)
NEXORA_GATEWAY_AUTH=off
NEXORA_GATEWAY_USER=
# At least 16 characters. Generate one, e.g.: openssl rand -base64 24
NEXORA_GATEWAY_PASSWORD=
# host:port of the API. Compose: api:8000. Railway: ${{api.RAILWAY_PRIVATE_DOMAIN}}:8000
# NEXORA_API_UPSTREAM=api:8000

# --- docker compose only -------------------------------------------------------------------------
POSTGRES_PASSWORD=nexora
