# NEXORA AI — environment variables. Copy to .env for local development.
# Contains NO real credentials. Never commit a filled-in .env (it is git-ignored).
# Every variable is optional locally; defaults live in src/nexora/settings.py.

# --- API + worker (prefix NEXORA_) -----------------------------------------------------------
# postgres://, postgresql:// and postgresql+psycopg:// are all accepted (rewritten to psycopg 3).
NEXORA_DATABASE_URL=postgresql+psycopg://nexora:nexora@localhost:5432/nexora
NEXORA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# --- Authentication (server-side sessions) ----------------------------------------------------
# Accounts are created with the operator CLI (password from a prompt, stdin or --generate):
#   uv run python -m nexora.auth.cli create-user <name> --generate
# Session lifetime: idle timeout and absolute maximum.
NEXORA_SESSION_IDLE_MINUTES=120
NEXORA_SESSION_ABSOLUTE_HOURS=12
# Secure (HTTPS-only, __Host- prefixed) session cookie. false only for plain-HTTP local stacks.
NEXORA_SESSION_COOKIE_SECURE=false
# Extra origins allowed to send writes (the request's own origin and NEXORA_CORS_ORIGINS always are).
NEXORA_TRUSTED_ORIGINS=
# Brute-force protection: failures per user name / per client within the window.
NEXORA_LOGIN_WINDOW_MINUTES=15
NEXORA_LOGIN_MAX_FAILURES_PER_USER=5
NEXORA_LOGIN_MAX_FAILURES_PER_CLIENT=30
# One-time provisioning without shell access: user name + Argon2id hash (never a password).
# Produce the hash with: uv run python -m nexora.auth.cli hash-password --generate
NEXORA_BOOTSTRAP_USERNAME=
NEXORA_BOOTSTRAP_PASSWORD_HASH=
# Serve /docs and /openapi.json. Set false wherever the API could be reached from the internet.
NEXORA_EXPOSE_API_DOCS=true
# Shared secret between gateway and API (>= 32 characters for the gateway's session mode).
# Empty = check disabled (local dev only).
NEXORA_GATEWAY_TOKEN=
# Connection pool per process (api and worker each hold one).
NEXORA_DB_POOL_SIZE=5
NEXORA_DB_MAX_OVERFLOW=5
# Upload limits (the gateway caps request bodies at 21 MiB).
NEXORA_MAX_UPLOAD_BYTES=20971520
NEXORA_MAX_CSV_ROWS=200000
# Worker: lease length, retry budget, idle poll interval.
NEXORA_JOB_LEASE_SECONDS=120
NEXORA_JOB_MAX_ATTEMPTS=3
NEXORA_WORKER_POLL_SECONDS=1.0
# API container: bind address and port (Railway sets PORT; use "::" only for IPv6-only private networks).
# NEXORA_BIND_HOST=0.0.0.0
# PORT=8000

# --- Gateway (apps/web image, Nginx) -----------------------------------------------------------
# session = the API authenticates every /api request (sign-in page); needs NEXORA_GATEWAY_TOKEN (default)
# basic   = additionally a shared HTTP Basic credential in front of everything (legacy / rollback)
# off     = no gateway token required (loopback-only stack); the API still requires sessions
NEXORA_GATEWAY_AUTH=session
NEXORA_GATEWAY_USER=
# At least 16 characters. Generate one, e.g.: openssl rand -base64 24
NEXORA_GATEWAY_PASSWORD=
# host:port of the API. Compose: api:8000. Railway: ${{api.RAILWAY_PRIVATE_DOMAIN}}:8000
# NEXORA_API_UPSTREAM=api:8000

# --- docker compose only -------------------------------------------------------------------------
POSTGRES_PASSWORD=nexora
