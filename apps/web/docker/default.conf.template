# NEXORA gateway: the single public entry point. Serves the built SPA and reverse-proxies the API
# over the private network. Rendered at container start by the nginx image's envsubst step;
# only ${NEXORA_*} and ${NGINX_LOCAL_RESOLVERS} are substituted (NGINX_ENVSUBST_FILTER).

# Re-resolve the API hostname at runtime: a redeployed API gets new private addresses.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;
resolver_timeout 5s;

# Client address for rate limiting. X-Forwarded-For is trusted only from private ranges
# (the platform edge proxy); a public client cannot spoof its rate-limit key.
set_real_ip_from 10.0.0.0/8;
set_real_ip_from 100.64.0.0/10;
set_real_ip_from 172.16.0.0/12;
set_real_ip_from 192.168.0.0/16;
set_real_ip_from fc00::/7;
real_ip_header X-Forwarded-For;
real_ip_recursive on;

limit_req_zone $binary_remote_addr zone=nexora_api:10m rate=20r/s;
# Writes (generate, analyse, case decisions) start analysis jobs and audit records: much stricter.
map $request_method $nexora_write_key {
  default "";
  POST    $binary_remote_addr;
  PUT     $binary_remote_addr;
  PATCH   $binary_remote_addr;
  DELETE  $binary_remote_addr;
}
limit_req_zone $nexora_write_key zone=nexora_writes:10m rate=30r/m;
limit_req_status 429;

# HSTS only when the edge terminated TLS.
map $http_x_forwarded_proto $nexora_hsts {
  default "";
  https   "max-age=31536000";
}

# Forward the original scheme from the edge, or the local one when there is no edge.
map $http_x_forwarded_proto $nexora_forwarded_proto {
  default $http_x_forwarded_proto;
  ""      $scheme;
}

server {
  listen 8080;
  # [::]:8080 where the kernel supports IPv6 (rendered by 10-nexora-gateway.envsh).
  include /tmp/nexora/listen-ipv6.conf;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  charset utf-8;

  # Matches NEXORA_MAX_UPLOAD_BYTES (20 MiB) plus multipart overhead.
  client_max_body_size 21m;
  client_body_timeout 30s;
  client_header_timeout 15s;

  gzip on;
  gzip_vary on;
  gzip_min_length 1024;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # Access control for everything below except /healthz (rendered by 10-nexora-gateway.envsh).
  include /tmp/nexora/auth.conf;
  include /etc/nginx/nexora/security-headers.conf;

  # Platform health check: proves the gateway is serving. Unauthenticated, reveals nothing.
  location = /healthz {
    auth_basic off;
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location /api/ {
    limit_req zone=nexora_api burst=40 nodelay;
    limit_req zone=nexora_writes burst=10 nodelay;
    set $nexora_api http://${NEXORA_API_UPSTREAM};
    proxy_pass $nexora_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $nexora_forwarded_proto;
    # Overwrites any client-supplied value: only the gateway can present the token.
    proxy_set_header X-Nexora-Gateway-Token "${NEXORA_GATEWAY_TOKEN}";
    proxy_set_header Authorization "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
  }

  # Readiness (database, migration, queue) through the gateway, for authenticated operators.
  location /health/ {
    limit_req zone=nexora_api burst=10 nodelay;
    set $nexora_api http://${NEXORA_API_UPSTREAM};
    proxy_pass $nexora_api;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Authorization "";
  }

  # API docs are not served by the gateway (and are disabled in the deployed API).
  location ~ ^/(docs|redoc|openapi\.json)$ {
    return 404;
  }

  # Content-hashed build output: cache for a year.
  location /assets/ {
    include /etc/nginx/nexora/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  # SPA fallback: every client route serves index.html, which must always be revalidated.
  location / {
    include /etc/nginx/nexora/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }
}
