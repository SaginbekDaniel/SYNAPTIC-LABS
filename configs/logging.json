{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "json": {
      "()": "nexora.logging_config.JsonFormatter"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "formatter": "json",
      "stream": "ext://sys.stderr"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "stderr"
    ]
  },
  "loggers": {
    "uvicorn": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.error": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    },
    "uvicorn.access": {
      "level": "INFO",
      "handlers": [],
      "propagate": true
    }
  }
}
